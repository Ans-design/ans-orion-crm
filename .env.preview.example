# ─── ANS ORION — aperçu / staging (Vercel Preview ou preview interne) ───
# Ne pas utiliser pour le dev quotidien Cursor — préférer .env.local

APP_ENV=preview
NODE_ENV=production

# Base dédiée preview (jamais la prod Hostinger)
# DATABASE_URL="postgresql://preview-user:pass@preview-host/preview?sslmode=require"

NEXT_PUBLIC_APP_URL=https://preview.example.com
NEXTAUTH_URL=https://preview.example.com
AUTH_TRUST_HOST=true

NEXTAUTH_SECRET="secret-preview"
AUTH_SECRET="identique-a-NEXTAUTH_SECRET"

# Pas de déploiement Hostinger depuis preview
DISABLE_HOSTINGER_DEPLOY=true
