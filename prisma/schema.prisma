  @@index([publicationStatus])
  @@index([archived])
  @@index([stockItemId])

  contextPrices MaterialContextPrice[]
}

/**
 * Prix mati?re par contexte ? source unique (pas de copie ISF/GF ind?pendante).
 * BaseMaterial = mati?re ; MaterialContextPrice = prix selon usage.
 */
model MaterialContextPrice {
  id             String   @id @default(cuid())
  excelId        String?  @unique
  baseMaterialId String
  material       BaseMaterial @relation(fields: [baseMaterialId], references: [id], onDelete: Cascade)
  /** Cl? d?normalis?e pour lookup rapide POS. */
  materialKey    String
  /** RAW_STOCK | PRINT_SMALL_FORMAT | PRINT_GRAND_FORMAT | BLANK_MATERIAL | PHOTO_PRINT | PVC_RIGID | DIRECT_COMPONENT */
