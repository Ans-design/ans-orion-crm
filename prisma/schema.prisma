  family            String   @default("Petit format")
  grammage          String?
  thickness         String?
  formatStandard    String?
  widthMm           Float?
  heightMm          Float?
  dimensionUnit     String   @default("mm") // mm | cm | m
  saleUnit          String   @default("pcs") // pcs | feuille | m | cm | m2 | lot | forfait
  unitDisplay       String?  // rame | rouleau | paquet | plaque
  unitStandard      String?  // feuille | m2 | m | pcs
  conversionFactor  Float?   // unit?s standard par unit? affich?e
  conversionFormula String?
  basePrintType     String?
