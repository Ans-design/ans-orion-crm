// === ANS Talk ? messagerie interne ===

model TalkConversation {
  id          String   @id @default(cuid())
  name        String
  type        String   // private | service | order | announcement
  serviceKey  String?
  commandeId  String?  @unique
  commande    Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  devisId     String?  @unique
  devis       Devis?   @relation(fields: [devisId], references: [id], onDelete: SetNull)
  productionDossierId String? @unique
  productionDossier   ProductionDossier? @relation(fields: [productionDossierId], references: [id], onDelete: SetNull)
  description String?
  label       String?
  pinned      Boolean  @default(false)
  noResponse  Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     TalkConversationMember[]
  messages    TalkMessage[]
  attachments TalkAttachment[]

  @@index([type])
  @@index([serviceKey])
}

model TalkConversationMember {
  id             String           @id @default(cuid())
  conversationId String
  conversation   TalkConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String           @default("member")
  lastReadAt     DateTime?
  muted          Boolean          @default(false)
  joinedAt       DateTime         @default(now())
  /** Révocation explicite — membership inactive si non null (V14 P0-17). */
  revokedAt      DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, revokedAt])
}

model TalkMessage {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    TalkConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String?
  senderName      String
  senderRole      String?
  body            String
  replyToId       String?
  replyTo         TalkMessage?     @relation("TalkMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  childReplies    TalkMessage[]    @relation("TalkMessageReplies")
  pinned          Boolean          @default(false)
  editedAt        DateTime?
  deletedAt       DateTime?
  deletedById     String?
  commandeId      String?
  proofId         String?
  metierTaskId    String?
  /** Idempotency client — UNIQUE avec conversation + auteur (V14 P0-13). */
  clientMessageId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reads           TalkMessageRead[]
  reactions       TalkMessageReaction[]
  attachments     TalkAttachment[]
  tasks           TalkMessageTask[]

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt])
}

model TalkMessageRead {
  id        String      @id @default(cuid())
  messageId String
  message   TalkMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  readAt    DateTime    @default(now())
  acked     Boolean     @default(false)

  @@unique([messageId, userId])
  @@index([userId])
}

model TalkMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   TalkMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
}

model TalkAttachment {
  id               String   @id @default(cuid())
  conversationId   String
  conversation     TalkConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId        String?
  message          TalkMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  commandeId       String?
  fileAssetId      String?
  fileName         String
  originalFileName String
  extension        String
  mimeType         String
  sizeBytes        Int
  storageKey       String?
  previewKey       String?
  checksumSha256   String
  version          String   @default("V1")
  status           String   @default("re?u")
  uploadedById     String?
  uploadedByName   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  versions         TalkAttachmentVersion[]
  downloads        TalkAttachmentDownload[]

  @@index([conversationId])
  @@index([messageId])
  @@index([commandeId])
}

model TalkAttachmentVersion {
  id             String         @id @default(cuid())
  attachmentId   String
  attachment     TalkAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  version        String
  storageKey     String
  checksumSha256 String
  uploadedById   String?
  createdAt      DateTime       @default(now())
}

model TalkAttachmentDownload {
