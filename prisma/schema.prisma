generator client {
    provider      = "prisma-client-js"
    output        = "../node_modules/.prisma/client"
    binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

/// Migration progressive — Paiement.type (vague 1)
enum PaiementType {
  Acompte
  Solde
  Remboursement
}

/// Statuts ledger — FIN-02 / paiements transactionnels
enum PaiementStatut {
  Initie
  En_attente
  Valide
  Rejete             @map("Rejeté")
  Annule             @map("Annulé")
  Rembourse_partiel  @map("Remboursé partiel")
  Rembourse_total    @map("Remboursé total")
}

enum DevisStatut {
  Brouillon
  Envoye         @map("Envoyé")
  En_attente     @map("En attente")
  Accepte        @map("Accepté")
  Refuse         @map("Refusé")
  Expire         @map("Expiré")
}

enum FactureStatut {
  Brouillon
  Emise              @map("Émise")
  Payee              @map("Payée")
  Partiellement_payee @map("Partiellement payée")
  Annulee            @map("Annulée")
}

enum LivraisonStatut {
  Preparation  @map("Préparation")
  Pret         @map("Prêt")
  En_livraison @map("En livraison")
  Livre        @map("Livré")
  Retour
}

enum CommandeStatut {
  A_planifier      @map("À planifier")
  En_attente_stock @map("En attente stock")
  En_production    @map("En production")
  En_finition      @map("En finition")
  Prete            @map("Prête")
  Livre            @map("Livré")
  Suspendu
  Annulee          @map("Annulée")
  Livree           @map("Livrée")
  Terminee         @map("Terminée")
  En_retard        @map("En retard")
}

enum ClientStatut {
  Actif
  Premium
  VIP
  Inactif
  Archive          @map("Archivé")
  Prospect
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  /** SEC-01 — forcer changement MDP après bootstrap / reset admin. */
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  preferences      UserPreference[]
  moduleOverrides  UserModuleOverride[]
  talkMemberships  TalkConversationMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Client {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  tel         String?
  whatsapp    String?
  email       String?
  type        String?    // Entreprise, Particulier, Institution, H?tellerie, etc.
  adresse     String?
  ville       String?
  canalVente      String?   // Bouche ? oreille, R?seaux sociaux, Salon?
  canalDecouverte String?
  canalCommande   String?   // POS, Email, WhatsApp, T?l?phone?
  ca          String?
  cmds        Int        @default(0)
  statut      ClientStatut @default(Actif)
  nif         String?
  statNumber  String?
  commercialName String?
  commercialId   String?
  categorie   String     @default("Client") // Prospect, Client, VIP
  relanceAt   DateTime?
  notes       String?
  charte      String?
  tags        String?    // JSON array string
  archived    Boolean    @default(false)
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  devis       Devis[]
  commandes   Commande[]
  factures    Facture[]
  paiements   Paiement[]
  livraisons  Livraison[]
  files         FileAsset[]
  proofs        Proof[]
  reclamations  ClientReclamation[]
  stockDirectSales StockDirectSale[]
  studioBriefs     StudioBrief[]
  cmCampaigns      CmCampaign[]
  cmRelances       CmRelance[]
  notificationLogs ClientNotificationLog[]

  @@index([statut])
  @@index([archived])
  @@index([email])
  @@index([name])
  @@index([tel])
  @@index([nif])
  @@index([archived, updatedAt])
}

/** R?clamations SAV / qualit? ? CRM direction */
model ClientReclamation {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /** Lien optionnel vers une commande du client (SAV) ? nullable pour legacy. */
  commandeId  String?
  commande    Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  /** Employé concerné (retour client ciblé) — sinon tous les intervenants commande. */
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  subject     String
  description String?
  statut      String    @default("Ouverte") // Ouverte, En cours, Résolue, Clôturée
  priorite    String    @default("Normale")  // Basse, Normale, Haute, Urgente
  archived    Boolean   @default(false)
  archivedAt  DateTime?
  archivedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@index([statut])
  @@index([commandeId])
  @@index([employeeId])
  @@index([archived])
}

/** Parc machines GPAO ? maintenance & charge */
model Machine {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  category        String    @default("impression") // impression, finition, decoupe
  status          String    @default("ok")        // ok, running, waiting, maintenance, down
  utilization     Int       @default(0)             // 0-100
  nextMaintenance DateTime?
  notes           String?
  site            String    @default("AX0")
  archived        Boolean   @default(false)
  archivedAt      DateTime?
  archivedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  maintenanceTickets MaintenanceTicket[]

  @@index([status])
  @@index([category])
  @@index([site])
  @@index([archived])
}

model Devis {
  id          String       @id @default(cuid())
  numero      String       @unique
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])
  items       Json?        // Legacy compat
  lignes      DevisLigne[]
  /** Montants MGA — ariary entiers (FIN-01). */
  sousTotal   Int          @default(0)
  remise      Int          @default(0)
  totalHT     Int          @default(0)
  totalTTC    Int          @default(0)
  statut      DevisStatut  @default(Brouillon)
  notes       String?
  validUntil  DateTime?
  acceptedAt  DateTime?
  logisticsSnapshot Json?  // Figé à l'acceptation (adresse, axe, expédition)
  commandes   Commande[]
  talkConversation TalkConversation?
  archived    Boolean      @default(false)
  archivedAt  DateTime?
  archivedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([statut])
  @@index([clientId])
  @@index([createdAt])
  @@index([statut, createdAt])
  @@index([validUntil])
  @@index([archived])
}

model DevisLigne {
  id                String   @id @default(cuid())
  devisId           String
  devis             Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  articleId         String
  articleLabel      String
  category          String
  configSnapshot    Json     // Full config snapshot at quote time
  quantity          Int      @default(1)
  unite             String   @default("ex.")
  /** Prix / totaux MGA — ariary entiers (FIN-01). */
  prixUnitaireAuto  Int      @default(0)
  prixUnitaireForce Int?
  totalForce        Int?
  totalLigne        Int      @default(0)
  pricingMode       String   @default("auto") // auto, force_pu, force_total
  priceReason       String?
  remarks           String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([devisId])
}

model Commande {
  id              String     @id @default(cuid())
  numero          String     @unique
  clientId        String?
  client          Client?    @relation(fields: [clientId], references: [id])
  devisId         String?
  devis           Devis?     @relation(fields: [devisId], references: [id])
  article         String
  configSnapshot  Json?      // Snapshot of configuration
  paymentSnapshot Json?      // Figé / resynchronisé à chaque encaissement
  qty             Int        @default(1)
  /** Montants MGA — ariary entiers (FIN-01). */
  total           Int        @default(0)
  acompte         Int        @default(0)
  reste           Int        @default(0)
  statut          CommandeStatut @default(A_planifier)
  avancement      Int        @default(0)
  operateur       String?
  dateCmd         DateTime   @default(now())
  dateLiv         DateTime?
  priorite        String     @default("Normal")
  machine         String?
  note            String?
  site            String     @default("AX0")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  productions     Production[]
  factures        Facture[]
  paiements       Paiement[]
  livraisons      Livraison[]
  proofs          Proof[]
  lignes          CommandeLigne[]
  metierTasks     MetierTask[]
  productionDossiers ProductionDossier[]
  studioBriefs    StudioBrief[]
  materialWastes  MaterialWaste[]
  talkConversations TalkConversation[]
  blocages        CommandeBlocage[]
  qualiteControle QualiteControle?
  reclamations    ClientReclamation[]
  archived        Boolean   @default(false)
  archivedAt      DateTime?
  archivedBy      String?

  @@index([statut])
  @@index([clientId])
  @@index([devisId])
  @@index([site])
  @@index([createdAt])
  @@index([statut, createdAt])
  @@index([archived])
}

model CommandeBlocage {
  id              String    @id @default(cuid())
  commandeId      String
  commande        Commande  @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  raison          String
  causeDetail     String?
  responsable     String?
  actionAttendue  String?
  statut          String    @default("actif") // actif | resolu
  resolvedAt      DateTime?
  resolvedBy      String?
  resolveNote     String?
  createdBy       String?
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([commandeId])
  @@index([statut])
}

model CommandeLigne {
  id             String    @id @default(cuid())
  commandeId     String
  commande       Commande  @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  articleId      String?
  articleLabel   String
  configSnapshot Json?
  quantity       Int       @default(1)
  totalLigne     Int       @default(0)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([commandeId])
}

// === Phase 2C: Modules M?tier ===

model Production {
  id            String            @id @default(cuid())
  commandeId    String
  commande      Commande          @relation(fields: [commandeId], references: [id])
  statut        String            @default("En attente") // En attente, En cours, Termin?, Bloqu?
  priorite      String            @default("Normal")     // Urgent, Haute, Normal, Basse
  operateur     String?
  machine       String?
  dateDebut     DateTime?
  dateFin       DateTime?
  avancement    Int               @default(0) // 0-100
  notes         String?
  proofPhotoUrl String?
  proofNote     String?
  proofAt       DateTime?
  proofBy       String?
  site          String            @default("AX0")
  etapes        ProductionEtape[]
  metierTasks   MetierTask[]
  dossier       ProductionDossier?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([commandeId])
  @@index([statut])
  @@index([site])
}

model ProductionEtape {
  id            String      @id @default(cuid())
  productionId  String
  production    Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  nom           String      // PAO, Impression, Finition, D?coupe, Contr?le qualit?, Emballage
  ordre         Int         @default(0)
  statut        String      @default("? faire") // ? faire, En cours, Termin?, Saut?
  operateur     String?
  machine       String?
  dateDebut     DateTime?
  dateFin       DateTime?
  dureeMin      Int?        // Dur?e estim?e en minutes
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([productionId])
}

model Facture {
  id            String      @id @default(cuid())
  numero        String      @unique
  commandeId    String?
  commande      Commande?   @relation(fields: [commandeId], references: [id])
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  lignes        Json?       // [{description, qty, pu, total}]
  /** Montants MGA — ariary entiers (FIN-01). */
  sousTotal     Int         @default(0)
  remise        Int         @default(0)
  tva           Float       @default(0)     // Taux TVA en % (pas un montant)
  totalHT       Int         @default(0)
  totalTTC      Int         @default(0)
  statut        FactureStatut @default(Brouillon)
  dateEmission  DateTime?
  dateEcheance  DateTime?
  notes         String?
  /** Format d’impression : ticket (simplifié) | facture (complète) — mêmes données. */
  printFormat   String      @default("facture")
  paiements     Paiement[]
  archived      Boolean     @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([statut])
  @@index([clientId])
  @@index([commandeId])
  @@index([createdAt])
  @@index([dateEmission])
  @@index([archived])
}

model Paiement {
  id            String      @id @default(cuid())
  numero        String      @unique
  factureId     String?
  facture       Facture?    @relation(fields: [factureId], references: [id])
  commandeId    String?
  commande      Commande?   @relation(fields: [commandeId], references: [id])
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  /** Montant MGA — ariary entier (FIN-01). */
  montant       Int         @default(0)
  mode          String      @default("Espèces") // Espèces, Virement, Mobile Money, Chèque, Carte
  reference     String?     // Référence du paiement (n° chèque, réf virement, etc.)
  /** DATA-006 — clé idempotente (provider + référence + portée). Unique si renseignée. */
  idempotencyKey String?    @unique
  type          PaiementType @default(Acompte)
  /** Ledger — seul Valide (et rembourse_partiel) compte dans l’acompte. */
  statut        PaiementStatut @default(Valide)
  datePaiement  DateTime    @default(now())
  notes         String?
  createdBy     String?
  createdByName String?
  /** Lien vers paiement d’origine (remboursement / annulation). */
  refundOfId    String?
  refundOf      Paiement?   @relation("PaiementRefunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds       Paiement[]  @relation("PaiementRefunds")
  cancelledAt   DateTime?
  cancelledBy   String?
  archived      Boolean     @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([factureId])
  @@index([commandeId])
  @@index([clientId])
  @@index([datePaiement])
  @@index([reference])
  @@index([statut])
  @@index([refundOfId])
  @@index([archived])
}

model Livraison {
  id            String      @id @default(cuid())
  numero        String      @unique
  commandeId    String
  commande      Commande    @relation(fields: [commandeId], references: [id])
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  statut        LivraisonStatut @default(Preparation)
  adresseLiv    String?
  contactLiv    String?
  telLiv        String?
  livreur       String?
  datePrevue    DateTime?
  dateLivree    DateTime?
  colisCount    Int         @default(1)
  poidsKg       Float?
  notes         String?
  proofPhotoUrl String?
  proofNote     String?
  proofAt       DateTime?
  archived      Boolean     @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([commandeId])
  @@index([clientId])
  @@index([statut])
  @@index([archived])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, ACCEPT, LOGIN
  entity      String   // Client, Devis, Commande, Production, Facture, Paiement, Livraison
  entityId    String?
  entityLabel String?  // Lisible: "CMD-00012", "Client Telma"
  details     String?  // JSON details of changes
  oldValue    Json?    // Snapshot champs modifi?s (avant)
  newValue    Json?    // Snapshot champs modifi?s (apr?s)
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

/** Session caisse journali?re ? ouverture / cl?ture par caissier */
model CashSession {
  id            String    @id @default(cuid())
  userId        String
  userName      String?
  status        String    @default("open") // open | closed
  openingFloat  Int       @default(0)
  closingCash   Int?
  expectedCash  Int?
  variance      Int?
  totalsJson    String?   // JSON { especes, mvola, orange, airtel, virement, cheque, carte }
  notes         String?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([openedAt])
}

model Tarif {
  id          String   @id @default(cuid())
  articleId   String   // ID from catalogue (e.g. "fly-flyer")
  articleLabel String
  palier      Int      @default(1)    // Quantity tier
  /** Prix MGA — ariary entiers (FIN-01). */
  prixUnitaire Int     @default(0)
  prixBase    Int?                  // Original base price for reference
  devise      String   @default("Ar")
  actif       Boolean  @default(true)
  notes       String?
  modifiePar  String?                 // Who changed it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([articleId, palier])
  @@index([articleId])
  @@index([actif])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   // appearance | notifications
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

model BusinessRule {
  id          String   @id @default(cuid())
  family      String
  articleId   String?
  ruleKey     String   @unique
  ruleName    String
  ruleType    String   // compatibility, force_price, filter, validation, qty
  condition   Json
  action      Json
  message     String?
  priority    Int      @default(100)
  active      Boolean  @default(true)
  connected   Boolean  @default(true)
  source      String?
  version     Int      @default(1)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([family])
  @@index([articleId])
  @@index([ruleType])
  @@index([active])
}

model PriceFormula {
  id          String   @id @default(cuid())
  family      String
  articleId   String
  formulaKey  String   @unique
  label       String
  expression  String
  variables   Json
  examples    Json?
  active      Boolean  @default(true)
  version     Int      @default(1)
  source      String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([family])
  @@index([articleId])
  @@index([active])
}

// === Moteur tarification dynamique (Phase 1) ? options POS, formules, paliers ===

/** Mod?le d'article backoffice ? h?ritage config par d?faut */
model ArticleTemplate {
  id                String   @id
  label             String
  family            String
  calculationType   String   @default("piece")
  saleUnit          String   @default("pi?ce")
  description       String   @default("")
  defaultVariables  String   @default("[]")
  exampleArticleIds String   @default("[]")
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([family])
  @@index([active])
}

/** Transitions workflow configurables (commande, cha?ne CRM) ? Lot 4 */
model WorkflowTransitionRule {
  id         String   @id @default(cuid())
  entity     String   // commande | chain
  fromStatut String
  toStatut   String
  enabled    Boolean  @default(true)
  actionKey  String?
  module     String?
  label      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entity, fromStatut, toStatut])
  @@index([entity, fromStatut])
  @@index([entity, enabled])
}

/** Profil tarifaire par article catalogue ? m?tadonn?es moteur dynamique */
model ArticlePricingProfile {
  id              String   @id @default(cuid())
  articleId       String   @unique
  articleLabel    String
  family          String
  calculationType String   @default("piece") // piece | m2 | cm2 | formula | laize | developpe
  saleUnit        String   @default("pi?ce")
  status          String   @default("draft") // draft | published | archived
  /** Prix MGA — ariary entiers (FIN-01). */
  prixBase        Int?
  prixM2          Int?
  prixCm2         Int?
  qtyMin          Float?
  active          Boolean  @default(true)
  source          String?  @default("config-types-seed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  optionGroups    ProductOptionGroup[]
  discountTiers   DiscountTier[]
  urgencyRules    UrgencyRule[]
  materialPrices  MaterialPrice[]
  formulaVersions FormulaVersion[]
  stockRules      StockRule[]

  @@index([family])
  @@index([status])
  @@index([active])
}

/** Groupe d'options POS (= ConfigField) ? flags admin tarification dynamique */
model ProductOptionGroup {
  id                       String   @id @default(cuid())
  articleId                String
  profile                  ArticlePricingProfile @relation(fields: [articleId], references: [articleId], onDelete: Cascade)
  fieldKey                 String
  label                    String
  sectionTitle             String
  sectionIcon              String?
  fieldType                String
  sortOrder                Int      @default(0)
  visiblePos               Boolean  @default(true)
  active                   Boolean  @default(true)
  required                 Boolean  @default(false)
  impactsPrice             Boolean  @default(false)
  impactsStock             Boolean  @default(false)
  impactsProduction        Boolean  @default(true)
  isInformational          Boolean  @default(false)
  requiresAdminValidation  Boolean  @default(false)
  metadata                 Json?
  source                   String?  @default("config-types-seed")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  values ProductOptionValue[]

  @@unique([articleId, fieldKey])
  @@index([articleId])
  @@index([visiblePos, active])
}

/** Valeur d'option (= chip / palette entry) */
model ProductOptionValue {
  id             String   @id @default(cuid())
  groupId        String
  group          ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  valueKey       String
  label          String
  sortOrder      Int      @default(0)
  /** LEGACY hybride — dual-read/write jusqu'au retrait différé (voir docs/MONEY_MIGRATION_RUNBOOK.md). */
  priceModifier  Float    @default(0)
  /** Supplément MGA (fixed | piece | m2). 0 si modifierType=multiplier. */
