/**
 * OutboxEvent — file d'attente durable (BAT/GPAO/sync). FLOW-002 V10 + V12.
 * Statuts : pending | processing | succeeded(=DONE) | failed | dead
 */
model OutboxEvent {
  id               String    @id @default(cuid())
  type             String
  aggregateType    String
  aggregateId      String
  aggregateVersion Int       @default(0)
  payload          String
  correlationId    String?
  causationId      String?
  /** Cle idempotente consommateur ? unique si renseignee. */
  idempotencyKey   String?   @unique
  status           String    @default("pending") // pending | processing | succeeded | failed | dead
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  lastError        String?
  lastErrorCode    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  processedAt      DateTime?

  @@index([status, availableAt])
  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([type, status])
}

/**
 * SyncRun ? execution durable d'une sync multi-etapes (Admin->POS, drift repair).
 */
model SyncRun {
  id              String    @id @default(cuid())
  type            String
  scope           String?
  requestedBy     String?
  dryRun          Boolean   @default(false)
  status          String    @default("pending") // pending | running | succeeded | partial | failed
  sourceVersion   String?
  targetVersion   String?
  total           Int       @default(0)
  succeeded       Int       @default(0)
  failed          Int       @default(0)
  skipped         Int       @default(0)
  errorSummary    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  steps           SyncRunStep[]

  @@index([type, status])
  @@index([createdAt])
}

model SyncRunStep {
  id          String    @id @default(cuid())
  runId       String
  run         SyncRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepKey     String
  entityType  String?
  entityId    String?
  status      String    @default("pending") // pending | running | succeeded | failed | skipped
  attempts    Int       @default(0)
  beforeHash  String?
  afterHash   String?
  errorCode   String?
  errorMsg    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([runId, stepKey])
  @@index([runId, status])
}

/**
 * Version monotone des permissions (V12 Lot 7).
 */
model PermissionPolicyMeta {
  id        String   @id @default("singleton")
  version   Int      @default(1)
  updatedBy String?
  note      String?
  updatedAt DateTime @updatedAt
}

/**
 * PricingRelease ? snapshot tarifaire immuable publie (V12 Lot 2).
 * Le POS lit uniquement status=active via PricingActivePointer.
 */
model PricingRelease {
  id                  String    @id @default(cuid())
  version             Int       @unique
  hash                String
  status              String    @default("draft") // draft | active | archived
  publishedAt         DateTime?
  createdBy           String?
  approvedBy          String?
  restoredFromVersion Int?
  /** Snapshot JSON freeze (profils, matieres, variables, formules?). */
  snapshotJson        String    @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  activePointer       PricingActivePointer?

  @@index([status, publishedAt])
}

/** Pointeur singleton vers la release active (1 ligne id=singleton). */
model PricingActivePointer {
  id         String         @id @default("singleton")
  releaseId  String         @unique
  release    PricingRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  updatedAt  DateTime       @updatedAt
}
