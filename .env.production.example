# ─── ANS ORION — PRODUCTION (Vercel + Neon / Supabase) ───
# ⚠️ Ne pas copier dans .env.local — configurer dans Vercel Project Settings → Environment Variables
# Voir aussi .env.vercel.example

APP_ENV=production
NODE_ENV=production

USE_PRODUCTION_DB=true
AUTH_TRUST_HOST=true
DEMO_MODE=false

DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# POSTGRES_PRISMA_URL=...

NEXTAUTH_SECRET="secret-production-64-caracteres-minimum"
AUTH_SECRET="identique-a-NEXTAUTH_SECRET"
NEXTAUTH_URL="https://votre-projet.vercel.app"

DISABLE_QUICK_LOGIN=true
ALLOW_PUBLIC_SIGNUP=false
ALLOW_V29_AUTH=false
