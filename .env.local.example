
# Mot de passe OBLIGATOIRE (≥8 car.) — aucun fallback ADM01 en code.
LOCAL_ADMIN_PASSWORD=CHANGE_ME_local_admin_min8

# ─── Comptes démo (optionnels — absents = pas de compte démo) ───
DEMO_ADMIN_EMAIL=admin@example.local
DEMO_ADMIN_PASSWORD=CHANGE_ME_demo_admin_min8
DEMO_EMAIL=demo@example.local
DEMO_PASSWORD=CHANGE_ME_demo_user_min8

# Matricules v29 — JSON tous profils (généré : node scripts/ensure-v29-local-passwords.mjs)
# Chaque matricule a son login (email ou matricule) + mot de passe propre.
# ORION_V29_PASSWORDS_JSON={"ADM01":"CHANGE_ME_adm01_min8","COM01":"CHANGE_ME_com01_min8","GRA01":"CHANGE_ME_gra01_min8"}
# Fallback catalogue prixDepart — LOCAL uniquement, jamais staging/prod
ALLOW_DEMO_PRICING_FALLBACK=true
NEXT_PUBLIC_ALLOW_DEMO_PRICING_FALLBACK=true
NEXT_PUBLIC_APP_ENV=local
# ALLOW_SETUP_DB=true
# SETUP_SECRET=remplacer-par-secret-setup-32-caracteres-min
E2E_EMAIL=demo@example.local
E2E_PASSWORD=CHANGE_ME_demo_user_min8