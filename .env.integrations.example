# Configuration intégrations — valeurs par défaut ANS Design
# Complétez RESEND_API_KEY et S3_* puis : npm run configure:integrations

# Resend — https://resend.com/api-keys (vérifier ansdesign.mg)
# RESEND_API_KEY="re_..."

EMAIL_FROM="ORION <alert@ansdesign.mg>"
PRODUCTION_URL="https://orion.ansdesign.mg"

# Cloudflare R2 — bucket ans-orion-files
# S3_BUCKET="ans-orion-files"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_FORCE_PATH_STYLE="true"
# S3_MAX_BYTES="15728640"
