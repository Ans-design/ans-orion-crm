# ─── ANS ORION — Vercel Production ───
# Project Settings → Environment Variables (Production + Preview)
# Chaque modification déclenche un nouveau déploiement Vercel.

USE_PRODUCTION_DB=true
AUTH_TRUST_HOST=true
DEMO_MODE=false

# Obligatoire — Neon / Supabase / Prisma Postgres (pooler recommandé)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optionnel — variables injectées par l'intégration Neon sur Vercel
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Auth (64+ caractères)
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=https://votre-projet.vercel.app

# Cron / setup (si utilisé)
# SETUP_SECRET=
