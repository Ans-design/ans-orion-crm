# ─── ANS ORION — environnement development (équipe / CI dev) ───
# Copier vers .env.development si besoin

APP_ENV=development
NODE_ENV=development

DATABASE_URL="file:./prisma/dev.db"

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

NEXTAUTH_SECRET="secret-development-a-changer"
AUTH_SECRET="identique-a-NEXTAUTH_SECRET"

NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
DISABLE_HOSTINGER_DEPLOY=true

E2E_BASE_URL=http://localhost:3000
